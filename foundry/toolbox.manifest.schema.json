{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai4ia/foundry/toolbox.manifest.schema.json",
  "title": "AI4IA Foundry toolbox manifest",
  "description": "Declarative definition of the single Foundry Agent Service toolbox that AI4IA fronts through the official-MCP APIM (see docs/foundry-toolbox.md). scripts/provision-foundry-toolbox.py reads this file and calls project.toolboxes.create_version(name, tools=[typed ToolboxTool models], description, skills, policies). The checked-in foundry/toolbox.manifest.json is the CANONICAL definition of the live ai4ia-toolbox that a new tenant reproduces 1:1. Fields mirror the Foundry toolbox declarative contract; camelCase keys here map to the API's snake_case (the script translates).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "tools", "skills", "connections"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Toolbox name (also the {toolbox_name} path segment in the MCP endpoint, and the mcp-servers.json entry name). Lowercase slug; pattern matches infra/mcp-servers.schema.json so the projected catalog entry is always valid.",
      "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable toolbox description (helps agents/operators understand its scope).",
      "minLength": 1,
      "maxLength": 512
    },
    "raiPolicyName": {
      "type": "string",
      "description": "Optional Responsible AI policy name that must already exist on the project (maps to policies.rai_config.rai_policy_name). AI4IA's foundry.bicep provisions 'ai4ia-annotate-only'.",
      "maxLength": 128
    },
    "connections": {
      "type": "array",
      "description": "Project connections the toolbox references by name (credentials live in the connection, never here). Each must already exist in the project (create with `azd ai connection create`).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tools": {
      "type": "array",
      "description": "Connectionless built-in tools and MCP tools to include. The service allows at most ONE tool total to omit `name`; give every other tool a unique `name`. Add a `description` to every tool to help model tool selection.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tool type. See docs/foundry-toolbox.md for per-tool config and regional/model limits (all preview).",
            "enum": [
              "web_search",
              "azure_ai_search",
              "code_interpreter",
              "file_search",
              "browser_automation_preview",
              "openapi",
              "toolbox_search_preview",
              "mcp"
            ]
          },
          "name": {
            "type": "string",
            "description": "Optional per-instance name; required when including multiple tools of the same type."
          },
          "description": {
            "type": "string",
            "description": "Optional tool description used by the model for tool selection."
          },
          "azureAiSearch": {
            "type": "object",
            "description": "Required nested config for azure_ai_search tools, mirroring azure-ai-projects 2.3.0's AzureAISearchToolResource. Do NOT put indexName/projectConnectionId at the tool root; the SDK constructor silently drops them there.",
            "additionalProperties": false,
            "required": ["indexes"],
            "properties": {
              "indexes": {
                "type": "array",
                "description": "The SDK currently supports at most one index per azure_ai_search tool (azure-ai-projects AzureAISearchToolResource.indexes docstring: 'maximum of 1 index resource').",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "description": "Microsoft's Azure AI Search tool 'Configure tool parameters' guide lists project_connection_id and index_name as BOTH Required, with no documented alternative; the SDK model also exposes an index_asset_id field, but it appears in no current Microsoft Learn doc as a supported substitute, so AI4IA does not accept it here (an unresolved-resource footgun otherwise) -- see docs/foundry-toolbox.md.",
                  "additionalProperties": false,
                  "required": ["indexName", "projectConnectionId"],
                  "properties": {
                    "indexName": { "type": "string", "minLength": 1 },
                    "projectConnectionId": { "type": "string", "minLength": 1 },
                    "queryType": { "type": "string" },
                    "topK": { "type": "integer" },
                    "filter": { "type": "string" }
                  }
                }
              }
            }
          },
          "customSearchConfiguration": {
            "type": "object",
            "description": "Optional grounding-with-Bing-custom-search config for web_search tools, mirroring azure-ai-projects 2.3.0's WebSearchConfiguration. Both fields are Required on that SDK model (no defaults, unlike azure_ai_search's index fields). Omit `customSearchConfiguration` entirely to use the tool's default (non-custom) grounded web search.",
            "additionalProperties": false,
            "required": ["projectConnectionId", "instanceName"],
            "properties": {
              "projectConnectionId": { "type": "string", "minLength": 1 },
              "instanceName": { "type": "string", "minLength": 1 }
            }
          },
          "browserAutomationPreview": {
            "type": "object",
            "description": "Required nested config for browser_automation_preview tools, mirroring azure-ai-projects 2.3.0's BrowserAutomationToolParameters.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
              "connection": {
                "type": "object",
                "description": "Playwright Workspace project connection (not a plain API connection).",
                "additionalProperties": false,
                "required": ["projectConnectionId"],
                "properties": {
                  "projectConnectionId": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "container": {
            "description": "Optional code_interpreter execution target, mirroring azure-ai-projects 2.3.0's CodeInterpreterToolboxTool.container: an EXISTING container ID (string -- a pre-registered container resource, NOT an image reference), or the Foundry-managed auto/managed-sandbox object (AutoCodeInterpreterToolParam) with optional resource limits. Omit entirely for the plain managed sandbox. There is no toolbox-level way to run a custom/BYO container image; for genuinely custom execution logic, expose it as your own server and add it as an `mcp` tool instead.",
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "auto" },
                  "fileIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "memoryLimit": { "type": "string", "enum": ["1g", "4g", "16g", "64g"] },
                  "networkPolicy": {
                    "type": "object",
                    "description": "Optional outbound network policy, mirroring azure-ai-projects 2.3.0's ContainerNetworkPolicyParam (disabled | allowlist). The SDK's allowlist variant also supports `domainSecrets` (per-domain literal secret values injected into the sandbox); AI4IA intentionally does NOT expose that field here because this manifest is committed to source control -- see docs/foundry-toolbox.md's secrets policy.",
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type"],
                        "properties": {
                          "type": { "const": "disabled" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "allowedDomains"],
                        "properties": {
                          "type": { "const": "allowlist" },
                          "allowedDomains": {
                            "type": "array",
                            "items": { "type": "string", "minLength": 1 },
                            "minItems": 1
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "vectorStoreIds": {
            "type": "array",
            "description": "Required-if-present vector store IDs to search (azure-ai-projects 2.3.0's FileSearchToolboxTool.vector_store_ids). The SDK allows omitting it, but a file_search tool with an empty list is inert, so if present it must be non-empty.",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "openapi": {
            "type": "object",
            "description": "Required nested function definition for openapi tools, mirroring azure-ai-projects 2.3.0's OpenApiFunctionDefinition. `spec` is an arbitrary, externally-authored OpenAPI document; scripts/provision-foundry-toolbox.py passes its contents through UNMODIFIED (property names inside spec are never rewritten, so e.g. a JSON-schema property genuinely named `topK` survives as `topK`).",
            "additionalProperties": false,
            "required": ["name", "spec", "auth"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The function name the model calls (OpenApiFunctionDefinition.name)."
              },
              "description": { "type": "string" },
              "spec": {
                "type": "object",
                "minProperties": 1,
                "description": "Opaque OpenAPI 3.x document. NOT validated or key-rewritten by this schema/script -- authored and owned by the API being described."
              },
              "auth": {
                "type": "object",
                "description": "OpenApiAuthDetails: anonymous | project_connection | managed_identity.",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["anonymous", "project_connection", "managed_identity"] },
                  "securityScheme": { "type": "object" }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": { "type": { "const": "project_connection" } },
                      "required": ["type"]
                    },
                    "then": {
                      "required": ["securityScheme"],
                      "properties": {
                        "securityScheme": {
                          "type": "object",
                          "required": ["projectConnectionId"],
                          "properties": { "projectConnectionId": { "type": "string", "minLength": 1 } }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": { "type": { "const": "managed_identity" } },
                      "required": ["type"]
                    },
                    "then": {
                      "required": ["securityScheme"],
                      "properties": {
                        "securityScheme": {
                          "type": "object",
                          "required": ["audience"],
                          "properties": { "audience": { "type": "string", "minLength": 1 } }
                        }
                      }
                    }
                  }
                ]
              },
              "defaultParams": {
                "type": "array",
                "description": "OpenAPI spec parameter names that use the caller-provided defaults instead of model-chosen values.",
                "items": { "type": "string" }
              }
            }
          },
          "serverLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Required identifier for mcp tools (used to identify the tool in tool calls; also what satisfies the 'at most one unnamed tool' rule for mcp, in place of `name`)."
          },
          "serverUrl": {
            "type": "string",
            "minLength": 1,
            "description": "mcp tool target URL. One of `serverUrl` or `connectorId` is required."
          },
          "connectorId": {
            "type": "string",
            "enum": [
              "connector_dropbox",
              "connector_gmail",
              "connector_googlecalendar",
              "connector_googledrive",
              "connector_microsoftteams",
              "connector_outlookcalendar",
              "connector_outlookemail",
              "connector_sharepoint"
            ],
            "description": "mcp tool built-in service connector (alternative to `serverUrl`). One of `serverUrl` or `connectorId` is required."
          },
          "projectConnectionId": {
            "type": "string",
            "minLength": 1,
            "description": "mcp-only tool-root project connection (unlike azure_ai_search/browser_automation_preview, this genuinely is a tool-root field in the SDK for mcp)."
          },
          "requireApproval": {
            "description": "mcp tool call approval policy: 'always' | 'never', or a per-tool-name policy object (azure-ai-projects 2.3.0's MCPToolRequireApproval; not deeply modeled here).",
            "oneOf": [
              { "type": "string", "enum": ["always", "never"] },
              { "type": "object" }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "web_search" } },
              "required": ["type"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "azure_ai_search" } },
              "required": ["type"]
            },
            "then": {
              "required": ["azureAiSearch"],
              "not": {
                "anyOf": [
                  { "required": ["indexName"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "code_interpreter" } },
              "required": ["type"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "file_search" } },
              "required": ["type"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "browser_automation_preview" } },
              "required": ["type"]
            },
            "then": {
              "required": ["browserAutomationPreview"],
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "openapi" } },
              "required": ["type"]
            },
            "then": {
              "required": ["openapi"],
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "toolbox_search_preview" } },
              "required": ["type"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] },
                  { "required": ["serverLabel"] },
                  { "required": ["serverUrl"] },
                  { "required": ["connectorId"] },
                  { "required": ["projectConnectionId"] },
                  { "required": ["requireApproval"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "mcp" } },
              "required": ["type"]
            },
            "then": {
              "required": ["serverLabel"],
              "anyOf": [{ "required": ["serverUrl"] }, { "required": ["connectorId"] }],
              "not": {
                "anyOf": [
                  { "required": ["azureAiSearch"] },
                  { "required": ["customSearchConfiguration"] },
                  { "required": ["browserAutomationPreview"] },
                  { "required": ["container"] },
                  { "required": ["vectorStoreIds"] },
                  { "required": ["openapi"] }
                ]
              }
            }
          }
        ]
      }
    },
    "skills": {
      "type": "array",
      "description": "Existing project skills to bind to the toolbox as MCP resources. Create them first with scripts/provision-foundry-skills.py (or `azd ai skill create`).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "description": "Optional skill version to pin (string). Omit to use the skill's default version."
          }
        }
      }
    }
  }
}
