# Base URL of the AI4IA backend API (server-side only; never exposed to the browser).
# Local dev assumes the FastAPI app on :8080. In Azure this is set to the api
# Container App's URL by infra/modules/web.bicep.
API_BASE_URL=http://localhost:8080

# Optional dev identity forwarded to the API's dev auth provider (X-Dev-User).
# Only used while the API runs with AI4IA_AUTH_PROVIDER=dev. Ignored under Entra.
DEV_USER=

# --- Authentication ---
# Frontend auth mode. Leave unset (or 'dev') for the default dev/demo flow, where
# the proxy injects DEV_USER and no sign-in is required. Set to 'entra' to turn on
# MSAL sign-in in the browser. When 'entra', all three ENTRA_* values below are
# required; if any is missing the app renders a configuration-error screen and
# never falls back to the dev flow.
WEB_AUTH_PROVIDER=dev

# Entra SPA app registration (client) ID for the web frontend.
ENTRA_CLIENT_ID=

# Entra tenant ID. Authority becomes https://login.microsoftonline.com/<tenant>.
ENTRA_TENANT_ID=

# API scope the SPA requests, matching the backend audience
# (e.g. api://<api-app-id>/.default).
ENTRA_API_SCOPE=

# Optional explicit redirect URI. Defaults to the page origin when unset.
ENTRA_REDIRECT_URI=

# --- Voice Live: real-time speech-to-speech ---
# Feature-flagged and default OFF. Leave VOICE_LIVE_ENABLED unset/false and no
# live-voice control is surfaced in the browser (the app is unchanged). When
# 'true', API_PUBLIC_URL must also be set: the browser opens the live-voice
# WebSocket directly against the API's external ingress (the Next.js HTTP proxy
# can't proxy WebSockets), converting the https URL to wss. Both are read
# server-side (like API_BASE_URL) and surfaced via the layout, NOT as NEXT_PUBLIC_*.
VOICE_LIVE_ENABLED=false
# Offer the governed-tools toggle inside Voice Live. Keep aligned with the API's
# AI4IA_REALTIME_TOOLS_ENABLED setting.
VOICE_LIVE_TOOLS_ENABLED=false

# Public https URL of the AI4IA backend API ingress (e.g. https://ca-api-….azurecontainerapps.io).
# Only used by the browser for the live-voice WebSocket; converted to wss client-side.
API_PUBLIC_URL=

# --- Document library: cross-session document understanding ---
# Feature-flagged and default OFF. Leave DOCUMENT_LIBRARY_ENABLED unset/false and
# no library control is surfaced in the browser (the app is unchanged). When
# 'true' the sidebar shows a Document library panel for uploading/managing files;
# the library API goes through the same-origin Next proxy (no public URL needed,
# unlike live voice). Read server-side and surfaced via the layout, NOT NEXT_PUBLIC_*.
# Drive this from the same infra flag as the API's AI4IA_DOCUMENT_UNDERSTANDING_ENABLED.
DOCUMENT_LIBRARY_ENABLED=false

# --- Custom tools / bring-your-own MCP servers ---
# Feature-flagged and default OFF. Leave CUSTOM_TOOLS_ENABLED unset/false and no
# custom-tools UI is surfaced in the browser (the app is unchanged). When 'true' the
# Agents & workflows builder shows a "Custom tools" tab to register/test/delete remote
# MCP (Streamable HTTP) servers and attach their discovered tools to an agent; the
# MCP-server API goes through the same-origin Next proxy (no public URL needed). Read
# server-side and surfaced via the layout, NOT NEXT_PUBLIC_*. Drive this from the same
# infra flag as the API's AI4IA_CUSTOM_TOOLS_ENABLED.
CUSTOM_TOOLS_ENABLED=false
