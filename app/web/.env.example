# Base URL of the AI4IA backend API (server-side only; never exposed to the browser).
# Local dev assumes the FastAPI app on :8080. In Azure this is set to the api
# Container App's URL by infra/modules/web.bicep.
API_BASE_URL=http://localhost:8080

# Optional dev identity forwarded to the API's dev auth provider (X-Dev-User).
# Only used while the API runs with AI4IA_AUTH_PROVIDER=dev. Ignored under Entra.
DEV_USER=

# --- Authentication (Phase 9) ---
# Frontend auth mode. Leave unset (or 'dev') for the default dev/demo flow, where
# the proxy injects DEV_USER and no sign-in is required. Set to 'entra' to turn on
# MSAL sign-in in the browser. When 'entra', all three ENTRA_* values below are
# required; if any is missing the app fails open to the dev flow.
WEB_AUTH_PROVIDER=dev

# Entra SPA app registration (client) ID for the web frontend.
ENTRA_CLIENT_ID=

# Entra tenant ID. Authority becomes https://login.microsoftonline.com/<tenant>.
ENTRA_TENANT_ID=

# API scope the SPA requests, matching the backend audience
# (e.g. api://<api-app-id>/.default).
ENTRA_API_SCOPE=

# Optional explicit redirect URI. Defaults to the page origin when unset.
ENTRA_REDIRECT_URI=
