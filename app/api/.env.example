# AI4IA API — local dev settings. Copy to .env and adjust.
# All variables are prefixed AI4IA_ (see config.py).

# local | dev | prod. Controls fail-closed behavior for dev auth + gateway.
AI4IA_ENV=local

# Auth provider: dev | entra. `dev` is only permitted when AI4IA_ENV=local
# (or AI4IA_ALLOW_DEV_AUTH=true).
AI4IA_AUTH_PROVIDER=dev
AI4IA_ALLOW_DEV_AUTH=false
# Fixed identity returned by the dev auth provider (overridable via X-Dev-User).
AI4IA_DEV_USER_SUB=dev-user
AI4IA_DEV_USER_NAME=Dev User
AI4IA_DEV_USER_EMAIL=dev@example.com

# Entra (only used when AI4IA_AUTH_PROVIDER=entra)
AI4IA_ENTRA_TENANT_ID=
AI4IA_ENTRA_AUDIENCE=
AI4IA_ENTRA_ALLOWED_TENANTS=

# Normal HTTP/SSE model gateway (SimpleL7Proxy -> APIM -> Foundry)
AI4IA_MODEL_GATEWAY_URL=http://localhost:9099
AI4IA_MODEL_GATEWAY_AUTH_MODE=none
AI4IA_MODEL_GATEWAY_API_KEY=
AI4IA_MODEL_GATEWAY_API_KEY_HEADER=Ocp-Apim-Subscription-Key
AI4IA_GATEWAY_PROVIDER_STYLE=azure_openai_native
AI4IA_GATEWAY_API_VERSION=2024-10-21

# --- Voice Live: real-time speech-to-speech relay ---
# Feature-flagged and default OFF. With AI4IA_REALTIME_ENABLED=false the
# /api/voice/live WebSocket refuses immediately, so the app is inert and its
# default behavior is unchanged. In a deployed environment the relay uses a
# separate APIM /openai base URL because SimpleL7Proxy does not support
# WebSockets. The browser never sees the deployment or the gateway key.
AI4IA_REALTIME_ENABLED=false
# Azure OpenAI realtime preview api-version (reached at {base}/realtime?...).
AI4IA_REALTIME_API_VERSION=2025-04-01-preview
# Upstream APIM base for realtime, e.g. https://<apim>.azure-api.net/openai.
# Local-only setups may leave it empty to fall back to AI4IA_MODEL_GATEWAY_URL.
AI4IA_REALTIME_BASE_URL=
# Upstream connect/handshake timeout (seconds).
AI4IA_REALTIME_TIMEOUT_SECONDS=30
# Optional hard clamp on a single live session's total duration (0 disables).
AI4IA_REALTIME_MAX_SESSION_SECONDS=0
# Comma-separated browser Origin allowlist for the relay handshake (WS handshakes
# aren't CORS-preflighted, so the relay validates Origin itself). Empty reflects
# (allows any) ONLY when AI4IA_ENV=local; in any deployed env an empty allowlist
# rejects every Origin (fail-closed), so set this when enabling realtime.
AI4IA_REALTIME_ALLOWED_ORIGINS=
# Governed tool calling inside a live voice session (calculator, current time).
# Inert unless AI4IA_REALTIME_ENABLED=true is also set. When both are on the
# relay injects the safe built-in tools into the client session and executes the
# model's function calls in-process through the same governed registry as chat.
AI4IA_REALTIME_TOOLS_ENABLED=false

# Sessions store: memory | cosmos
AI4IA_SESSION_STORE=memory
AI4IA_COSMOS_ENDPOINT=
AI4IA_COSMOS_DATABASE=ai4ia

# --- Document & multimodal understanding: per-user library ---
# Feature-flagged and default OFF. With AI4IA_DOCUMENT_UNDERSTANDING_ENABLED=false
# the per-user document library + ingest pipeline are never constructed and the
# /api/library API refuses (404), so the app's default behavior is unchanged.
# Enabling it outside AI4IA_ENV=local requires the cosmos session store AND a
# Content Understanding endpoint AND a blob account (fail-closed in validate_runtime).
AI4IA_DOCUMENT_UNDERSTANDING_ENABLED=false
# Max bytes accepted for a single library upload.
AI4IA_DOCUMENT_MAX_UPLOAD_BYTES=50000000
# Max documents retained per user in the library (0 = unlimited).
AI4IA_DOCUMENT_MAX_PER_USER=200

# --- Custom tools / bring-your-own MCP servers ---
# Feature-flagged and default OFF. With AI4IA_CUSTOM_TOOLS_ENABLED=false the
# per-user MCP-server registry is never constructed and the
# /api/agents/mcp-servers API refuses (404), so the app's default behavior is
# unchanged. When enabled, users register remote MCP (Streamable HTTP) servers;
# we connect behind a strict SSRF egress guard and cache the tools they offer.
# Enabling it outside AI4IA_ENV=local requires the cosmos session store so the
# registry is durable, and a Key Vault for durable connection secrets (both
# fail-closed in validate_runtime).
AI4IA_CUSTOM_TOOLS_ENABLED=false
# Per-user MCP-server cap (0 = use the generous module default of 20).
AI4IA_CUSTOM_TOOLS_MAX_SERVERS_PER_USER=0
# Discovery connect/handshake timeout (seconds) for the MCP client.
AI4IA_CUSTOM_TOOLS_DISCOVERY_TIMEOUT_SECONDS=15
# Azure Key Vault URI for durable MCP connection secrets. Required
# when AI4IA_CUSTOM_TOOLS_ENABLED=true outside local; authenticated servers'
# credentials are stored here (only a reference is kept on the Cosmos record).
# The api managed identity needs the "Key Vault Secrets Officer" role. Empty
# locally falls back to a process-local store.
AI4IA_CUSTOM_TOOLS_SECRET_VAULT_URI=

# Content Understanding ingest. The async REST endpoint that cracks an
# upload into Markdown + fields. Empty disables enrichment: uploads still store +
# get an instant local-text summary, but stay at status `stored` (no chunks). When
# enabled in a deployed env this MUST be set (validate_runtime fails closed).
AI4IA_CU_BASE_URL=
AI4IA_CU_API_VERSION=2025-11-01
# Upstream auth: bearer (api managed identity, Cognitive Services scope) | api_key.
AI4IA_CU_AUTH_MODE=bearer
AI4IA_CU_API_KEY=
# Poll cadence + ceiling for the async analyze operation (seconds).
AI4IA_CU_TIMEOUT_SECONDS=30
AI4IA_CU_POLL_INTERVAL_SECONDS=2
AI4IA_CU_MAX_POLL_SECONDS=300
# Prebuilt CU analyzers used per modality (override to pin a different analyzer).
AI4IA_CU_DOCUMENT_ANALYZER=prebuilt-documentSearch
AI4IA_CU_IMAGE_ANALYZER=prebuilt-imageSearch
AI4IA_CU_AUDIO_ANALYZER=prebuilt-audioSearch
AI4IA_CU_VIDEO_ANALYZER=prebuilt-videoSearch

# Blob storage for the raw + parsed + chunk artifacts (AAD-only; the browser never
# sees a blob URL). Empty uses an in-memory store (local/dev only). Required (with
# CU) when enabling document understanding in a deployed env.
AI4IA_DOCUMENT_BLOB_ACCOUNT_URL=
AI4IA_DOCUMENT_BLOB_CONTAINER=documents
# Heading-aware Markdown chunking for the retrieval index (chars + overlap).
AI4IA_DOCUMENT_CHUNK_CHARS=1200
AI4IA_DOCUMENT_CHUNK_OVERLAP=150
# Hard cap on chunks indexed per document (0 = unlimited; a larger parse is
# truncated + logged) and the embed/index batch size (bounds request size + memory).
AI4IA_DOCUMENT_MAX_CHUNKS=5000
AI4IA_DOCUMENT_EMBED_BATCH=128
# Retrieval consumer: how the library reaches the chat hot path.
# Only ready documents ever contribute. top_k = RAG chunks pulled per turn;
# context_max_docs = Tier-1 summary cards injected; context_max_chars budgets the
# whole injected library block; fetch_max_chars caps one fetch_document tool read.
AI4IA_DOCUMENT_RETRIEVAL_TOP_K=6
AI4IA_DOCUMENT_CONTEXT_MAX_DOCS=20
AI4IA_DOCUMENT_CONTEXT_MAX_CHARS=8000
AI4IA_DOCUMENT_FETCH_MAX_CHARS=12000

# Azure AI Search backs the document chunk index when set: the library's CU-parsed
# chunks are indexed here (durable, semantic-ready) instead of pgvector/in-memory.
# Endpoint is the provisioned service URL (https://<svc>.search.windows.net),
# reached AAD-only via the api managed identity (RBAC: Search Index Data Contributor
# + Service Contributor) — no admin keys. Empty leaves the feature dormant (pgvector
# if Postgres is configured, else the in-memory store). The index is created lazily
# (idempotently) on first use.
AI4IA_SEARCH_ENDPOINT=
AI4IA_SEARCH_INDEX_NAME=ai4ia-doc-chunks
# When a query carries text (RAG retrieval always does), the AI Search backend runs
# a hybrid query (vector + BM25 keyword) and, with this ON, applies the L2 semantic
# reranker for better top-k ordering. Falls back to plain hybrid if the semantic
# tier is unavailable. Only affects the AI Search backend. Default true.
AI4IA_SEARCH_SEMANTIC_RANKING=true

# --- Compute over the library: intent router + code_interpreter +
# "adjust & return" export ---
# Layered ON TOP of document understanding: a second default-OFF flag guarding the
# highest-regression-risk surface (the chat hot path). With
# AI4IA_DOCUMENT_COMPUTE_ENABLED=false the intent router never runs, neither the
# run_code nor export_document synthetic tool is advertised, the version-download
# endpoint refuses, and chat is byte-for-byte unchanged. Enabling it requires
# AI4IA_DOCUMENT_UNDERSTANDING_ENABLED=true (validate_runtime fails closed otherwise).
AI4IA_DOCUMENT_COMPUTE_ENABLED=false
# Code Interpreter rides the Azure OpenAI Responses API built-in code_interpreter
# tool (a sandboxed Azure-managed Python container), NOT a chat-completions
# deployment: POST {base}/openai/v1/responses with
# tools:[{type:"code_interpreter",container:{type:"auto"}}]. Base url is the bare
# resource endpoint (https://<resource>.openai.azure.com); /openai/v1 is appended
# by the client. Base url + model are REQUIRED when compute is enabled outside local.
AI4IA_CODE_INTERPRETER_BASE_URL=
AI4IA_CODE_INTERPRETER_MODEL=
# Empty => Responses API v1 GA (no api-version). Set to "preview" to opt into the
# latest preview surface.
AI4IA_CODE_INTERPRETER_API_VERSION=
# bearer => AAD managed-identity token (scope below); api_key => the resource key
# in the api-key header (set AI4IA_CODE_INTERPRETER_API_KEY).
AI4IA_CODE_INTERPRETER_AUTH_MODE=bearer
AI4IA_CODE_INTERPRETER_API_KEY=
AI4IA_CODE_INTERPRETER_AAD_SCOPE=https://ai.azure.com/.default
AI4IA_CODE_INTERPRETER_TIMEOUT_SECONDS=120
# Max chars of parsed (ready-gated) document text handed to CI per run, and max
# chars of a single "adjust & return" exported artifact.
AI4IA_CODE_INTERPRETER_MAX_INPUT_CHARS=60000
AI4IA_DOCUMENT_EXPORT_MAX_CHARS=200000
# Raw-file compute: when true, run_code uploads the document's ORIGINAL bytes (the
# uploaded PDF/xlsx/csv/…) to the Responses Files API and attaches them to the
# code-interpreter container, so the sandbox reads the real file instead of its
# CU-parsed text. Only CI-supported file types within the size cap are eligible;
# anything else (or any upload failure) falls back to the parsed-text path. Default
# false (parsed-text only). Max raw upload size in bytes (default 25 MiB).
AI4IA_CODE_INTERPRETER_RAW_FILES=false
AI4IA_CODE_INTERPRETER_MAX_RAW_FILE_BYTES=26214400

# --- Inline-attachment Code Interpreter (default-OFF) ---
# Lets the chat agent crack/analyze an INLINE composer attachment with the SAME
# Code Interpreter sandbox the library run_code tool uses, reading the REAL
# uploaded file (PDF layout / xlsx cells / image) instead of the cheap local text
# extract. Augments — does NOT replace — the instant text-extract path: the local
# extract still feeds chat context every turn; this only adds an agent-callable
# analyze_attachment tool for heavy/binary files or compute-needing tasks. Default
# OFF: when false NO original bytes are retained, NO ephemeral store is touched,
# and the tool is never advertised, so the inline-document path is byte-for-byte
# unchanged. Reuses the AI4IA_CODE_INTERPRETER_* settings above + the raw-file size
# cap (no second CI surface); base url + model are REQUIRED when enabled outside
# local (validate_runtime fails closed otherwise). Independent of the document
# library (does NOT require AI4IA_DOCUMENT_UNDERSTANDING_ENABLED).
AI4IA_INLINE_DOCUMENT_COMPUTE_ENABLED=false
# Dedicated blob container for the EPHEMERAL retained originals (reuses the
# document blob account; infra attaches a 1-day lifecycle/TTL expiry to it). Unset
# locally/in tests => an in-memory store.
AI4IA_INLINE_ATTACHMENT_BLOB_CONTAINER=ephemeral-attachments

# --- Agent-callable image tool ---
# The generate_image tool is a synthetic capability any agent can attach; it
# persists generated images to a dedicated blob account and serves them through
# the authenticated GET /api/images/artifacts/{id} endpoint. Leave the account
# URL empty for local/dev and the api falls back to an in-memory artifact store
# (works, but images are lost on restart). In a deployed env the infra provisions
# a dedicated account and injects these. Container defaults to "images".
AI4IA_IMAGE_BLOB_ACCOUNT_URL=
AI4IA_IMAGE_BLOB_CONTAINER=images

# --- Agent-callable video tool ---
# The generate_video tool mirrors generate_image: a synthetic capability any agent
# can attach; it persists generated MP4 clips to blob storage (the shared media
# account, "videos" container) and serves them through the authenticated
# GET /api/videos/artifacts/{id} endpoint. Leave the account URL empty for
# local/dev and the api falls back to an in-memory artifact store (works, but
# clips are lost on restart). The poll/timeout knobs bound how long a turn waits
# for Sora's async job before giving up.
AI4IA_VIDEO_BLOB_ACCOUNT_URL=
AI4IA_VIDEO_BLOB_CONTAINER=videos
AI4IA_GATEWAY_VIDEO_API_VERSION=preview
AI4IA_GATEWAY_VIDEO_POLL_INTERVAL_SECONDS=5
AI4IA_GATEWAY_VIDEO_MAX_WAIT_SECONDS=240

# --- Web IQ search tools (default-OFF) ---
# Exposes Microsoft Web IQ (web / news / videos / images / browse) as synthetic
# tools to any tool-enabled agent + the main chat, via the official `webiq` SDK.
# Default OFF: when AI4IA_WEB_SEARCH_ENABLED=false no SDK client is constructed and
# no web tool is ever advertised, so the chat path is byte-for-byte unchanged. To
# enable, set it true AND supply auth — either an API key (AI4IA_WEBIQ_API_KEY) or
# EntraID (AI4IA_WEBIQ_USE_ENTRA=true, using DefaultAzureCredential). Outside local
# one of the two is required or startup fails closed. AI4IA_WEBIQ_BASE_URL
# optionally overrides the Web IQ endpoint. The two caps bound results per search
# and the browse-content length returned to the model.
AI4IA_WEB_SEARCH_ENABLED=false
AI4IA_WEBIQ_API_KEY=
AI4IA_WEBIQ_BASE_URL=
AI4IA_WEBIQ_USE_ENTRA=false
AI4IA_WEB_SEARCH_MAX_RESULTS=5
AI4IA_WEB_SEARCH_MAX_CONTENT_CHARS=6000

# Observability
AI4IA_LOG_LEVEL=INFO
# Application Insights connection string. This is ALSO the on/off switch for
# OpenTelemetry export: when set, the API initializes Azure Monitor at startup
# and ships request/dependency/exception traces, metrics, and a per-completion
# `chat_completion` customEvent (model, agent, tokens, cost, status) to App
# Insights. Leave EMPTY for local/dev — telemetry export is then a pure no-op
# (the SDK is never started; structured stdout logging is unaffected). In live
# this is injected automatically from the workspace-linked App Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Admin usage dashboard resource metrics (default-degraded) ---
# The admin dashboard (GET /api/admin/usage/* + /api/admin/metrics/resources, all
# behind require_admin) aggregates the per-user usage ledger with no extra config.
# The resource panels below are best-effort: each ARM resource id left empty (or
# the SDK/Monitor data absent) renders that panel as "unavailable" rather than an
# error, so the dashboard ships before diagnostics are wired. Reads go through the
# api managed identity (RBAC: Monitoring Reader) via azure-monitor-query. Set
# AI4IA_RESOURCE_METRICS_ENABLED=false to disable all panels outright.
AI4IA_RESOURCE_METRICS_ENABLED=true
AI4IA_METRICS_SEARCH_RESOURCE_ID=
AI4IA_METRICS_POSTGRES_RESOURCE_ID=
AI4IA_METRICS_COSMOS_RESOURCE_ID=
AI4IA_METRICS_CONTAINER_APP_RESOURCE_ID=
