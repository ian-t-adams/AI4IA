<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="priority_policy_0_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_0_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_1_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_2_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_3_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_4_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_5_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_6_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_7_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_8_33" />
    <include-fragment fragment-id="endpoint_selection_catalog_9_33" />
    <include-fragment fragment-id="endpoint_selection_setup_33" />
    <include-fragment fragment-id="priority_policy_1_33" />
  </inbound>
  <!-- Control if and how the requests are forwarded to services  -->
  <backend>
    <retry condition="@(context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;RetryRemaining&quot;, true))" count="50" interval="1" delta="1">
      <include-fragment fragment-id="priority_policy_2_33" />
      <include-fragment fragment-id="priority_policy_3_33" />
      <include-fragment fragment-id="priority_policy_4_33" />
    </retry>
  </backend>
  <!-- Customize the responses -->
  <outbound>
    <base />
    <include-fragment fragment-id="priority_policy_5_33" />
  </outbound>
  <!-- Handle exceptions and customize error responses  -->
  <on-error>
    <include-fragment fragment-id="priority_policy_6_33" />
    <base />
  </on-error>
</policies>
