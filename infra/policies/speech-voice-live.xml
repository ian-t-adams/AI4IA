<policies>
  <inbound>
    <base />
    <!-- GENERATED by scripts/gen-voice-provider-catalog.py from the managed-model catalog. -->
    <choose>
      <when condition="@{
            string model = context.Request.Url.Query.GetValueOrDefault(&quot;model&quot;, &quot;&quot;);
            return !String.IsNullOrWhiteSpace(model) &amp;&amp;
              !(
              &quot;gpt-realtime&quot;.Equals(model, StringComparison.Ordinal) ||
              &quot;gpt-realtime-mini&quot;.Equals(model, StringComparison.Ordinal) ||
              &quot;gpt-4.1&quot;.Equals(model, StringComparison.Ordinal) ||
              &quot;gpt-4.1-mini&quot;.Equals(model, StringComparison.Ordinal) ||
              &quot;gpt-5-mini&quot;.Equals(model, StringComparison.Ordinal) ||
              &quot;gpt-5.1&quot;.Equals(model, StringComparison.Ordinal)
              );
          }">
        <return-response>
          <set-status code="400" reason="Voice Live model is not in the AI4IA catalog" />
        </return-response>
      </when>
    </choose>
    <set-query-parameter name="model" exists-action="override">
      <value>@(String.IsNullOrWhiteSpace(context.Request.Url.Query.GetValueOrDefault("model", "")) ? "gpt-realtime" : context.Request.Url.Query.GetValueOrDefault("model", ""))</value>
    </set-query-parameter>
    <set-query-parameter name="api-version" exists-action="override">
      <value>2026-04-10</value>
    </set-query-parameter>
    <set-query-parameter name="deployment" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-query-parameter name="api-key" exists-action="delete" />
    <set-query-parameter name="agent_id" exists-action="delete" />
    <set-query-parameter name="project_id" exists-action="delete" />
    <set-backend-service base-url="{{speech-voice-live-wss-endpoint}}/voice-live/realtime" />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-AI4IA-App-Id" exists-action="delete" />
    <set-header name="X-AI4IA-User-Id" exists-action="delete" />
    <set-header name="X-UserProfile" exists-action="delete" />
    <authentication-managed-identity resource="{{speech-voice-live-mi-audience}}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <return-response>
      <set-status code="502" reason="Speech Voice Live handshake failed" />
    </return-response>
  </on-error>
</policies>
