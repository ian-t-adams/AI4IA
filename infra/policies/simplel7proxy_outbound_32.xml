<fragment>
<!-- Retry exhausted without a usable response (e.g. all backends throttled after a timeout).
		     The <retry> exits gracefully to outbound instead of on-error, so anything reaching here
		     with no unthrottled backend left is that leaked case: return 429 instead of a bare 500. -->
<choose>
			<when condition="@(!(context.Variables.GetValueOrDefault&lt;bool>(&quot;callCompleted&quot;, false) &amp;&amp; context.Response != null &amp;&amp; context.Response.StatusCode == 200) &amp;&amp; context.Variables.GetValueOrDefault&lt;int>(&quot;unThrottledBackends&quot;, -1) == 0)">
				<set-status code="429" reason="No Backends Available" />
				<set-body>@(new JObject { { "statusCode", 429 }, { "statusReason", "No Backends Available" } }.ToString(Newtonsoft.Json.Formatting.None))</set-body>
				<set-header name="retry-after-ms" exists-action="override">
					<value>@(context.Variables.GetValueOrDefault&lt;int>("sleepDuration", 10000).ToString())</value>
				</set-header>
			</when>
		</choose>
<!-- TOKENPROCESSOR asks SimpleL7Proxy to stream the response through a
		     line-based JSON processor so token usage can be extracted. That
		     processor (JsonStreamProcessor) reads the body with a StreamReader and
		     re-emits it with WriteLineAsync, which is LOSSY for anything that is not
		     text: bytes that are not valid UTF-8 become U+FFFD (ef bf bd) and raw
		     0x0D/0x0A bytes are consumed as line terminators and rewritten as the
		     platform newline. Setting this unconditionally corrupted every binary
		     response: /audio/speech mp3 reached the browser as UTF-8 mojibake under
		     an intact audio/mpeg Content-Type, so no downstream content-type check
		     could catch it and playback failed with MEDIA_ERR_SRC_NOT_SUPPORTED.
		     Only request parsing when the body really is text (chat completions are
		     application/json, streaming chat is text/event-stream); otherwise leave
		     the header off so the proxy falls back to its byte-clean pass-through
		     processor, and strip any value a backend may have echoed. -->
<choose>
			<when condition="@{
				string ct = context.Response.Headers.GetValueOrDefault(&quot;Content-Type&quot;, &quot;&quot;) ?? &quot;&quot;;
				ct = ct.TrimStart().ToLowerInvariant();
				return ct.StartsWith(&quot;application/json&quot;) || ct.StartsWith(&quot;text/&quot;);
			}">
				<set-header name="TOKENPROCESSOR" exists-action="override">
					<value>MultiLineAllUsage</value>
				</set-header>
			</when>
			<otherwise>
				<set-header name="TOKENPROCESSOR" exists-action="delete" />
			</otherwise>
		</choose>
<set-header name="@((string)context.Variables[&quot;AffinityHeaderName&quot;])" exists-action="override">
			<value>@(context.Variables.GetValueOrDefault&lt;JObject>("selectedBackend", null)?.Value&lt;string>("affinity") ?? "")</value>
		</set-header>
<set-header name="x-Backend-Attempts" exists-action="override">
			<value>@(context.Variables.GetValueOrDefault&lt;int>("backendCallCounter", 0).ToString())</value>
		</set-header>
<set-header name="@((string)context.Variables[&quot;PolicyCycleCounterHeaderName&quot;])" exists-action="override">
			<value>@(context.Variables.GetValueOrDefault&lt;int>("PolicyCycleCounter", 0).ToString())</value>
		</set-header>
<set-header name="backendLog" exists-action="override">
			<value>@{
				string dbgStr = context.Variables.GetValueOrDefault&lt;string>("DbgStr", "");
				JArray actLog = context.Variables.GetValueOrDefault&lt;JArray>("activityLog", new JArray());
				string result = string.Join(" | ", actLog.Select(entry =>
					((JObject)entry).Value&lt;string>("Elapsed") + "s " + ((JObject)entry).Value&lt;string>("message")
				));
				result = string.IsNullOrEmpty(dbgStr) ? result : dbgStr + " | " + result;
				return result.Length > 4000 ? result.Substring(0, 4000) + "..." : result;
			}</value>
		</set-header>
<set-header name="X-Policy-LastError" exists-action="override">
			<value>@{
				JArray errArr = context.Variables.GetValueOrDefault&lt;JArray>("lastPolicyError", new JArray());
				return errArr.Count == 0 ? "" : errArr.ToString(Newtonsoft.Json.Formatting.None);
			}</value>
		</set-header>
<!-- <include-fragment fragment-id="LogResponseFragment" /> -->
</fragment>
