{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI4IA model catalog",
  "description": "Data-driven Foundry model deployment catalog consumed by infra/main.bicep.",
  "type": "object",
  "required": ["naming", "regions", "catalog"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "naming": {
      "type": "object",
      "required": ["subscriptionToken", "foundryToken", "pattern", "skuShort"],
      "properties": {
        "_comment": { "type": "string" },
        "subscriptionToken": { "type": "string", "minLength": 1, "description": "Token stamped into every model deployment name ({model}-{subscriptionToken}-{region}-{skuShort}). Read by bicep + the catalog scripts + the runtime; change it (per tenant/subscription) and regenerate the catalog." },
        "foundryToken": { "type": "string", "minLength": 1, "description": "Token naming the Foundry accounts/projects (mf-<foundryToken>-<env>-<region>). Read by bicep for account/project/toolbox-URL naming." },
        "pattern": { "type": "string" },
        "skuShort": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["dataZone", "primary"],
        "properties": {
          "dataZone": { "type": "string", "enum": ["US", "EU"] },
          "primary": { "type": "boolean" },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "format", "category", "deployments"],
        "properties": {
          "name": { "type": "string" },
          "format": { "type": "string" },
          "category": { "type": "string" },
          "contextWindow": { "type": "integer", "minimum": 1 },
          "maxOutputTokens": { "type": "integer", "minimum": 1 },
          "deployments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["region", "sku", "capacity", "version"],
              "properties": {
                "region": { "type": "string" },
                "sku": {
                  "type": "string",
                  "enum": ["GlobalStandard", "DataZoneStandard", "Standard", "GlobalBatch", "DataZoneBatch"]
                },
                "capacity": { "type": "integer", "minimum": 1 },
                "version": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
