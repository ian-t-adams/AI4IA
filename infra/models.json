{
  "$schema": "./models.schema.json",
  "_comment": "Generated from live az cognitiveservices model list, reconciled to live catalog + quota (gen_catalog_v2). Each deployment pins an explicit model version. `reasoningEffort` is the set of reasoning_effort values the model actually accepts, established on 2026-07-31 by sending each value to the live deployment and recording the status - NOT from documentation, which is wrong for this field, and not from the provider's own 'Supported values are: ...' error, which over-reports for gpt-5.4-pro and under-reports for gpt-5.4. Re-probe with a direct Foundry call (proxy/APIM retries hide the 400) when adding a reasoning model.",
  "naming": {
    "_comment": "Naming tokens for the whole stack (single source of truth). `subscriptionToken` is stamped into every model deployment name; `foundryToken` names the Foundry accounts/projects (mf-<foundryToken>-<env>-<region>). main.bicep, scripts/gen-model-catalog.py, scripts/validate-catalog.py, and app/api catalog.py all read these, so changing them here (plus AZURE_ENV_NAME) is what makes a subscription/tenant move 1:1. After changing, run scripts/gen-model-catalog.py to regenerate the runtime catalog. See docs/runbooks/deployment.md (Moving to a new subscription/tenant).",
    "subscriptionToken": "slurmfactory",
    "foundryToken": "aiforia",
    "pattern": "{model}-{subscriptionToken}-{region}-{skuShort}",
    "skuShort": {
      "GlobalStandard": "glbl",
      "DataZoneStandard": "dz",
      "Standard": "std"
    }
  },
  "regions": {
    "eastus2": {
      "dataZone": "US",
      "primary": true,
      "roles": [
        "chat",
        "voice",
        "image",
        "video"
