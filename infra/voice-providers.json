{
  "$schema": "./voice-providers.schema.json",
  "_comment": "Authoritative voice provider/capability catalog for AI4IA. scripts/gen-voice-provider-catalog.py projects this into packaged API JSON, a typed web TypeScript module, and the Speech Voice Live APIM policy. Keep the provider IDs stable (`azure_openai`, `speech_voice_live`), keep Azure OpenAI deployment selection sourced from infra/models.json, and keep Speech Voice Live limited to the curated managed-model catalog and built-in voices.",
  "defaultProviderId": "azure_openai",
  "providers": [
    {
      "id": "azure_openai",
      "displayName": "Azure OpenAI Realtime",
      "displayLabel": "Azure OpenAI",
      "description": "Deployment-catalog realtime voice provider backed by infra/models.json realtime deployments.",
      "transport": "websocket",
      "selectionMode": "deployment_catalog",
      "endpointPath": "/openai/realtime",
      "modelCatalogRef": {
        "sourceJson": "infra/models.json",
        "filter": {
          "category": "realtime"
        },
        "defaultModelId": "gpt-realtime"
      },
      "sessionDefaults": {
        "voice": "alloy",
        "inputTranscription": "whisper-1",
        "turnDetection": "server_vad",
        "interruptResponse": true,
        "autoTruncate": false
      },
      "capabilities": {
        "voices": {
          "kind": "openai-realtime",
          "default": "alloy",
          "options": [
            "alloy",
            "ash",
            "ballad",
            "coral",
            "echo",
            "sage",
            "shimmer",
            "verse",
            "marin",
            "cedar"
          ]
        },
        "inputTranscription": {
          "provider": "openai",
          "default": "whisper-1",
          "options": [
            "whisper-1"
          ]
        },
        "turnDetection": {
          "default": "server_vad",
          "options": [
            "server_vad",
            "semantic_vad"
          ]
        },
        "interruption": {
          "interruptResponse": true,
          "autoTruncate": false
        },
        "customVoice": {
          "enabled": false,
          "allowEndpointIds": false,
          "allowLexicons": false,
          "allowPersonalVoice": false
        }
      }
    },
    {
      "id": "speech_voice_live",
      "displayName": "Azure Speech Voice Live",
      "displayLabel": "Azure Speech",
      "description": "Catalog-driven managed Voice Live provider backed by Azure Speech in Foundry Tools.",
      "transport": "websocket",
      "selectionMode": "managed_model_catalog",
      "endpointPath": "/voice-live/realtime",
      "defaultManagedModelId": "gpt-realtime",
      "managedModels": [
        {
          "id": "gpt-realtime",
          "displayName": "GPT Realtime",
          "description": "Native-audio realtime model with GPT-4o transcription.",
          "profile": "native_audio",
          "inputTranscription": {
            "provider": "openai",
            "model": "gpt-4o-transcribe"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        },
        {
          "id": "gpt-realtime-mini",
          "displayName": "GPT Realtime Mini",
          "description": "Lower-cost native-audio realtime model with GPT-4o transcription.",
          "profile": "native_audio",
          "inputTranscription": {
            "provider": "openai",
            "model": "gpt-4o-transcribe"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        },
        {
          "id": "gpt-4.1",
          "displayName": "GPT-4.1",
          "description": "GPT-4.1 response model paired with the Azure Speech chain.",
          "profile": "azure_speech_chain",
          "inputTranscription": {
            "provider": "azure_speech",
            "model": "azure-speech"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        },
        {
          "id": "gpt-4.1-mini",
          "displayName": "GPT-4.1 Mini",
          "description": "GPT-4.1 Mini response model paired with the Azure Speech chain.",
          "profile": "azure_speech_chain",
          "inputTranscription": {
            "provider": "azure_speech",
            "model": "azure-speech"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        },
        {
          "id": "gpt-5-mini",
          "displayName": "GPT-5 Mini",
          "description": "GPT-5 Mini response model paired with the Azure Speech chain.",
          "profile": "azure_speech_chain",
          "inputTranscription": {
            "provider": "azure_speech",
            "model": "azure-speech"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        },
        {
          "id": "gpt-5.1",
          "displayName": "GPT-5.1",
          "description": "GPT-5.1 response model paired with the Azure Speech chain.",
          "profile": "azure_speech_chain",
          "inputTranscription": {
            "provider": "azure_speech",
            "model": "azure-speech"
          },
          "apiVersion": "2026-04-10",
          "initialRegion": "eastus2",
          "audioFormat": "pcm16",
          "sampleRateHz": 24000
        }
      ],
      "sessionDefaults": {
        "voice": "en-US-Ava:DragonHDLatestNeural",
        "turnDetection": "azure_semantic_vad",
        "locale": "en-US",
        "noiseSuppression": "azure_deep_noise_suppression",
        "echoCancellation": "server_echo_cancellation",
        "interruptResponse": true,
        "autoTruncate": false
      },
      "capabilities": {
        "voices": {
          "kind": "azure-standard",
          "default": "en-US-Ava:DragonHDLatestNeural",
          "options": [
            "en-US-Ava:DragonHDLatestNeural",
            "en-US-AvaNeural",
            "en-US-AndrewNeural",
            "en-US-Brian:DragonHDLatestNeural",
            "en-US-Emma:DragonHDLatestNeural",
            "en-US-Jenny:DragonHDLatestNeural"
          ]
        },
        "turnDetection": {
          "default": "azure_semantic_vad",
          "options": [
            "azure_semantic_vad",
            "azure_semantic_vad_multilingual"
          ]
        },
        "noiseSuppression": {
          "default": "azure_deep_noise_suppression",
          "options": [
            "azure_deep_noise_suppression"
          ]
        },
        "echoCancellation": {
          "default": "server_echo_cancellation",
          "options": [
            "server_echo_cancellation"
          ]
        },
        "interruption": {
          "interruptResponse": true,
          "autoTruncate": false
        },
        "locale": {
          "default": "en-US",
          "options": [
            "en-US"
          ]
        },
        "customVoice": {
          "enabled": false,
          "allowEndpointIds": false,
          "allowLexicons": false,
          "allowPersonalVoice": false
        }
      }
    }
  ]
}
