{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI4IA voice provider catalog",
  "description": "Authoritative, closed voice provider and managed-model catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultProviderId",
    "providers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./voice-providers.schema.json"
    },
    "_comment": {
      "type": "string"
    },
    "defaultProviderId": {
      "const": "azure_openai"
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        {
          "$ref": "#/definitions/azureOpenAiProvider"
        },
        {
          "$ref": "#/definitions/speechVoiceLiveProvider"
        }
      ]
    }
  },
  "definitions": {
    "azureOpenAiProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "displayLabel",
        "description",
        "transport",
        "selectionMode",
        "endpointPath",
        "modelCatalogRef",
        "sessionDefaults",
        "capabilities"
      ],
      "properties": {
        "id": {
          "const": "azure_openai"
        },
        "displayName": {
          "const": "Azure OpenAI Realtime"
        },
        "displayLabel": {
          "const": "Azure OpenAI"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "websocket"
        },
        "selectionMode": {
          "const": "deployment_catalog"
        },
        "endpointPath": {
          "const": "/openai/realtime"
        },
        "modelCatalogRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceJson",
            "filter",
            "defaultModelId"
          ],
          "properties": {
            "sourceJson": {
              "const": "infra/models.json"
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category"
              ],
              "properties": {
                "category": {
                  "const": "realtime"
                }
              }
            },
            "defaultModelId": {
              "const": "gpt-realtime"
            }
          }
        },
        "sessionDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "inputTranscription",
            "turnDetection",
            "interruptResponse",
            "autoTruncate"
          ],
          "properties": {
            "voice": {
              "const": "alloy"
            },
            "inputTranscription": {
              "const": "whisper-1"
            },
            "turnDetection": {
              "const": "server_vad"
            },
            "interruptResponse": {
              "const": true
            },
            "autoTruncate": {
              "const": false
            }
          }
        },
        "capabilities": {
          "$ref": "#/definitions/azureOpenAiCapabilities"
        }
      }
    },
    "azureOpenAiCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voices",
        "inputTranscription",
        "turnDetection",
        "interruption",
        "customVoice"
      ],
      "properties": {
        "voices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "default",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "openai-realtime"
            },
            "default": {
              "const": "alloy"
            },
            "options": {
              "const": [
                "alloy",
                "ash",
                "ballad",
                "coral",
                "echo",
                "sage",
                "shimmer",
                "verse",
                "marin",
                "cedar"
              ]
            }
          }
        },
        "inputTranscription": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "default",
            "options"
          ],
          "properties": {
            "provider": {
              "const": "openai"
            },
            "default": {
              "const": "whisper-1"
            },
            "options": {
              "const": [
                "whisper-1"
              ]
            }
          }
        },
        "turnDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "server_vad"
            },
            "options": {
              "const": [
                "server_vad",
                "semantic_vad"
              ]
            }
          }
        },
        "interruption": {
          "$ref": "#/definitions/interruption"
        },
        "customVoice": {
          "$ref": "#/definitions/customVoice"
        }
      }
    },
    "speechVoiceLiveProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "displayLabel",
        "description",
        "transport",
        "selectionMode",
        "endpointPath",
        "defaultManagedModelId",
        "managedModels",
        "sessionDefaults",
        "capabilities"
      ],
      "properties": {
        "id": {
          "const": "speech_voice_live"
        },
        "displayName": {
          "const": "Azure Speech Voice Live"
        },
        "displayLabel": {
          "const": "Azure Speech"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "websocket"
        },
        "selectionMode": {
          "const": "managed_model_catalog"
        },
        "endpointPath": {
          "const": "/voice-live/realtime"
        },
        "defaultManagedModelId": {
          "const": "gpt-realtime"
        },
        "managedModels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "additionalItems": false,
          "items": [
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtimeModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtimeMiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt41Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt41MiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt5MiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt51Model"
                }
              ]
            }
          ]
        },
        "sessionDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "turnDetection",
            "locale",
            "noiseSuppression",
            "echoCancellation",
            "interruptResponse",
            "autoTruncate"
          ],
          "properties": {
            "voice": {
              "const": "en-US-Ava:DragonHDLatestNeural"
            },
            "turnDetection": {
              "const": "azure_semantic_vad"
            },
            "locale": {
              "const": "en-US"
            },
            "noiseSuppression": {
              "const": "azure_deep_noise_suppression"
            },
            "echoCancellation": {
              "const": "server_echo_cancellation"
            },
            "interruptResponse": {
              "const": true
            },
            "autoTruncate": {
              "const": false
            }
          }
        },
        "capabilities": {
          "$ref": "#/definitions/speechCapabilities"
        }
      }
    },
    "speechManagedModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "profile",
        "inputTranscription",
        "apiVersion",
        "initialRegion",
        "audioFormat",
        "sampleRateHz"
      ],
      "properties": {
        "id": {
          "enum": [
            "gpt-realtime",
            "gpt-realtime-mini",
            "gpt-4.1",
            "gpt-4.1-mini",
            "gpt-5-mini",
            "gpt-5.1"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "profile": {
          "enum": [
            "native_audio",
            "azure_speech_chain"
          ]
        },
        "inputTranscription": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "azure_speech"
              ]
            },
            "model": {
              "enum": [
                "gpt-4o-transcribe",
                "azure-speech"
              ]
            }
          }
        },
        "apiVersion": {
          "const": "2026-04-10"
        },
        "initialRegion": {
          "const": "eastus2"
        },
        "audioFormat": {
          "const": "pcm16"
        },
        "sampleRateHz": {
          "const": 24000
        }
      }
    },
    "gptRealtimeModel": {
      "properties": {
        "id": {
          "const": "gpt-realtime"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gptRealtimeMiniModel": {
      "properties": {
        "id": {
          "const": "gpt-realtime-mini"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gpt41Model": {
      "properties": {
        "id": {
          "const": "gpt-4.1"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt41MiniModel": {
      "properties": {
        "id": {
          "const": "gpt-4.1-mini"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt5MiniModel": {
      "properties": {
        "id": {
          "const": "gpt-5-mini"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt51Model": {
      "properties": {
        "id": {
          "const": "gpt-5.1"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "openAiTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "const": "openai"
        },
        "model": {
          "const": "gpt-4o-transcribe"
        }
      }
    },
    "azureSpeechTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "const": "azure_speech"
        },
        "model": {
          "const": "azure-speech"
        }
      }
    },
    "speechCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voices",
        "turnDetection",
        "noiseSuppression",
        "echoCancellation",
        "interruption",
        "locale",
        "customVoice"
      ],
      "properties": {
        "voices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "default",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "azure-standard"
            },
            "default": {
              "const": "en-US-Ava:DragonHDLatestNeural"
            },
            "options": {
              "const": [
                "en-US-Ava:DragonHDLatestNeural",
                "en-US-AvaNeural",
                "en-US-AndrewNeural",
                "en-US-Brian:DragonHDLatestNeural",
                "en-US-Emma:DragonHDLatestNeural",
                "en-US-Jenny:DragonHDLatestNeural"
              ]
            }
          }
        },
        "turnDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "azure_semantic_vad"
            },
            "options": {
              "const": [
                "azure_semantic_vad",
                "azure_semantic_vad_multilingual"
              ]
            }
          }
        },
        "noiseSuppression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "azure_deep_noise_suppression"
            },
            "options": {
              "const": [
                "azure_deep_noise_suppression"
              ]
            }
          }
        },
        "echoCancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "server_echo_cancellation"
            },
            "options": {
              "const": [
                "server_echo_cancellation"
              ]
            }
          }
        },
        "interruption": {
          "$ref": "#/definitions/interruption"
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "en-US"
            },
            "options": {
              "const": [
                "en-US"
              ]
            }
          }
        },
        "customVoice": {
          "$ref": "#/definitions/customVoice"
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interruptResponse",
        "autoTruncate"
      ],
      "properties": {
        "interruptResponse": {
          "const": true
        },
        "autoTruncate": {
          "const": false
        }
      }
    },
    "customVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowEndpointIds",
        "allowLexicons",
        "allowPersonalVoice"
      ],
      "properties": {
        "enabled": {
          "const": false
        },
        "allowEndpointIds": {
          "const": false
        },
        "allowLexicons": {
          "const": false
        },
        "allowPersonalVoice": {
          "const": false
        }
      }
    }
  }
}
