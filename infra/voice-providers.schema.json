{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI4IA voice provider catalog",
  "description": "Authoritative, closed voice provider and managed-model catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultProviderId",
    "providers",
    "photoAvatars"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./voice-providers.schema.json"
    },
    "_comment": {
      "type": "string"
    },
    "defaultProviderId": {
      "const": "azure_openai"
    },
    "photoAvatars": {
      "$ref": "#/definitions/photoAvatarCatalog"
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        {
          "$ref": "#/definitions/azureOpenAiProvider"
        },
        {
          "$ref": "#/definitions/speechVoiceLiveProvider"
        }
      ]
    }
  },
  "definitions": {
    "azureOpenAiProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "displayLabel",
        "description",
        "transport",
        "selectionMode",
        "endpointPath",
        "modelCatalogRef",
        "sessionDefaults",
        "capabilities"
      ],
      "properties": {
        "id": {
          "const": "azure_openai"
        },
        "displayName": {
          "const": "Azure OpenAI Realtime"
        },
        "displayLabel": {
          "const": "Azure OpenAI"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "websocket"
        },
        "selectionMode": {
          "const": "deployment_catalog"
        },
        "endpointPath": {
          "const": "/openai/realtime"
        },
        "modelCatalogRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceJson",
            "filter",
            "defaultModelId"
          ],
          "properties": {
            "sourceJson": {
              "const": "infra/models.json"
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "runtimeEnabled"
              ],
              "properties": {
                "category": {
                  "const": "realtime"
                },
                "runtimeEnabled": {
                  "const": true
                }
              }
            },
            "defaultModelId": {
              "const": "gpt-realtime"
            }
          }
        },
        "sessionDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "inputTranscription",
            "turnDetection",
            "interruptResponse",
            "autoTruncate"
          ],
          "properties": {
            "voice": {
              "const": "alloy"
            },
            "inputTranscription": {
              "const": "whisper-1"
            },
            "turnDetection": {
              "const": "server_vad"
            },
            "interruptResponse": {
              "const": true
            },
            "autoTruncate": {
              "const": false
            }
          }
        },
        "capabilities": {
          "$ref": "#/definitions/azureOpenAiCapabilities"
        }
      }
    },
    "azureOpenAiCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voices",
        "inputTranscription",
        "turnDetection",
        "interruption",
        "customVoice"
      ],
      "properties": {
        "voices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "default",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "openai-realtime"
            },
            "default": {
              "const": "alloy"
            },
            "options": {
              "const": [
                "alloy",
                "ash",
                "ballad",
                "coral",
                "echo",
                "sage",
                "shimmer",
                "verse",
                "marin",
                "cedar"
              ]
            }
          }
        },
        "inputTranscription": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "default",
            "options"
          ],
          "properties": {
            "provider": {
              "const": "openai"
            },
            "default": {
              "const": "whisper-1"
            },
            "options": {
              "const": [
                "whisper-1"
              ]
            }
          }
        },
        "turnDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "server_vad"
            },
            "options": {
              "const": [
                "server_vad",
                "semantic_vad"
              ]
            }
          }
        },
        "interruption": {
          "$ref": "#/definitions/interruption"
        },
        "customVoice": {
          "$ref": "#/definitions/customVoice"
        }
      }
    },
    "speechVoiceLiveProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "displayLabel",
        "description",
        "transport",
        "selectionMode",
        "endpointPath",
        "defaultManagedModelId",
        "managedModels",
        "sessionDefaults",
        "capabilities"
      ],
      "properties": {
        "id": {
          "const": "speech_voice_live"
        },
        "displayName": {
          "const": "Azure Speech Voice Live"
        },
        "displayLabel": {
          "const": "Azure Speech"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "websocket"
        },
        "selectionMode": {
          "const": "managed_model_catalog"
        },
        "endpointPath": {
          "const": "/voice-live/realtime"
        },
        "defaultManagedModelId": {
          "const": "gpt-realtime"
        },
        "managedModels": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "additionalItems": false,
          "items": [
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtimeModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtimeMiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtime15Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtime21Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gptRealtime21MiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt41Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt41MiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt5MiniModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt51Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt52Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt54Model"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt56TerraModel"
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/speechManagedModel"
                },
                {
                  "$ref": "#/definitions/gpt56LunaModel"
                }
              ]
            }
          ]
        },
        "sessionDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "turnDetection",
            "locale",
            "noiseSuppression",
            "echoCancellation",
            "interruptResponse",
            "autoTruncate"
          ],
          "properties": {
            "voice": {
              "const": "en-US-Ava:DragonHDLatestNeural"
            },
            "turnDetection": {
              "const": "azure_semantic_vad"
            },
            "locale": {
              "const": "en-US"
            },
            "noiseSuppression": {
              "const": "azure_deep_noise_suppression"
            },
            "echoCancellation": {
              "const": "server_echo_cancellation"
            },
            "interruptResponse": {
              "const": true
            },
            "autoTruncate": {
              "const": false
            }
          }
        },
        "capabilities": {
          "$ref": "#/definitions/speechCapabilities"
        }
      }
    },
    "speechManagedModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "profile",
        "inputTranscription",
        "apiVersion",
        "initialRegion",
        "audioFormat",
        "sampleRateHz"
      ],
      "properties": {
        "id": {
          "enum": [
            "gpt-realtime",
            "gpt-realtime-mini",
            "gpt-realtime-1.5",
            "gpt-realtime-2.1",
            "gpt-realtime-2.1-mini",
            "gpt-4.1",
            "gpt-4.1-mini",
            "gpt-5-mini",
            "gpt-5.1",
            "gpt-5.2",
            "gpt-5.4",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "profile": {
          "enum": [
            "native_audio",
            "azure_speech_chain"
          ]
        },
        "inputTranscription": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "azure_speech"
              ]
            },
            "model": {
              "enum": [
                "gpt-4o-transcribe",
                "azure-speech"
              ]
            }
          }
        },
        "apiVersion": {
          "const": "2026-04-10"
        },
        "initialRegion": {
          "const": "eastus2"
        },
        "audioFormat": {
          "const": "pcm16"
        },
        "sampleRateHz": {
          "const": 24000
        }
      }
    },
    "gptRealtimeModel": {
      "properties": {
        "id": {
          "const": "gpt-realtime"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gptRealtimeMiniModel": {
      "properties": {
        "id": {
          "const": "gpt-realtime-mini"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gptRealtime15Model": {
      "properties": {
        "id": {
          "const": "gpt-realtime-1.5"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gptRealtime21Model": {
      "properties": {
        "id": {
          "const": "gpt-realtime-2.1"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gptRealtime21MiniModel": {
      "properties": {
        "id": {
          "const": "gpt-realtime-2.1-mini"
        },
        "profile": {
          "const": "native_audio"
        },
        "inputTranscription": {
          "$ref": "#/definitions/openAiTranscription"
        }
      }
    },
    "gpt41Model": {
      "properties": {
        "id": {
          "const": "gpt-4.1"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt41MiniModel": {
      "properties": {
        "id": {
          "const": "gpt-4.1-mini"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt5MiniModel": {
      "properties": {
        "id": {
          "const": "gpt-5-mini"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt51Model": {
      "properties": {
        "id": {
          "const": "gpt-5.1"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt52Model": {
      "properties": {
        "id": {
          "const": "gpt-5.2"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt54Model": {
      "properties": {
        "id": {
          "const": "gpt-5.4"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt56TerraModel": {
      "properties": {
        "id": {
          "const": "gpt-5.6-terra"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "gpt56LunaModel": {
      "properties": {
        "id": {
          "const": "gpt-5.6-luna"
        },
        "profile": {
          "const": "azure_speech_chain"
        },
        "inputTranscription": {
          "$ref": "#/definitions/azureSpeechTranscription"
        }
      }
    },
    "openAiTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "const": "openai"
        },
        "model": {
          "const": "gpt-4o-transcribe"
        }
      }
    },
    "azureSpeechTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "const": "azure_speech"
        },
        "model": {
          "const": "azure-speech"
        }
      }
    },
    "speechCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voices",
        "inputTranscription",
        "turnDetection",
        "noiseSuppression",
        "echoCancellation",
        "interruption",
        "locale",
        "customVoice"
      ],
      "properties": {
        "voices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "default",
            "options",
            "previewOptions"
          ],
          "properties": {
            "kind": {
              "const": "azure-standard"
            },
            "default": {
              "const": "en-US-Ava:DragonHDLatestNeural"
            },
            "options": {
              "const": [
                "en-US-Ava:DragonHDLatestNeural",
                "en-US-AvaNeural",
                "en-US-AndrewNeural",
                "en-US-Brian:DragonHDLatestNeural",
                "en-US-Emma:DragonHDLatestNeural",
                "en-US-Jenny:DragonHDLatestNeural",
                "en-US-Ethan:MAI-Voice-2.1-Flash",
                "en-US-Grant:MAI-Voice-2.1-Flash",
                "en-US-Harper:MAI-Voice-2.1-Flash",
                "en-US-Iris:MAI-Voice-2.1-Flash",
                "en-US-Jasper:MAI-Voice-2.1-Flash",
                "en-US-Olivia:MAI-Voice-2.1-Flash",
                "en-US-Sage:MAI-Voice-2.1-Flash",
                "en-US-Ethan:MAI-Voice-2.1",
                "en-US-Grant:MAI-Voice-2.1",
                "en-US-Harper:MAI-Voice-2.1",
                "en-US-Iris:MAI-Voice-2.1",
                "en-US-Jasper:MAI-Voice-2.1",
                "en-US-Olivia:MAI-Voice-2.1",
                "en-US-Sage:MAI-Voice-2.1"
              ]
            },
            "previewOptions": {
              "description": "Public-preview voices (no SLA). A subset of options that never includes the default voice.",
              "const": [
                "en-US-Ethan:MAI-Voice-2.1-Flash",
                "en-US-Grant:MAI-Voice-2.1-Flash",
                "en-US-Harper:MAI-Voice-2.1-Flash",
                "en-US-Iris:MAI-Voice-2.1-Flash",
                "en-US-Jasper:MAI-Voice-2.1-Flash",
                "en-US-Olivia:MAI-Voice-2.1-Flash",
                "en-US-Sage:MAI-Voice-2.1-Flash",
                "en-US-Ethan:MAI-Voice-2.1",
                "en-US-Grant:MAI-Voice-2.1",
                "en-US-Harper:MAI-Voice-2.1",
                "en-US-Iris:MAI-Voice-2.1",
                "en-US-Jasper:MAI-Voice-2.1",
                "en-US-Olivia:MAI-Voice-2.1",
                "en-US-Sage:MAI-Voice-2.1"
              ]
            }
          }
        },
        "inputTranscription": {
          "type": "object",
          "additionalProperties": false,
          "description": "Transcription models a user may select instead of a managed model's own inputTranscription.model default, each limited to the managed-model profiles that support it.",
          "required": [
            "options"
          ],
          "properties": {
            "options": {
              "const": [
                {
                  "model": "mai-transcribe-2",
                  "displayName": "MAI Transcribe 2",
                  "preview": true,
                  "profiles": [
                    "native_audio",
                    "azure_speech_chain"
                  ]
                }
              ]
            }
          }
        },
        "turnDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "azure_semantic_vad"
            },
            "options": {
              "const": [
                "azure_semantic_vad",
                "azure_semantic_vad_multilingual"
              ]
            }
          }
        },
        "noiseSuppression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "azure_deep_noise_suppression"
            },
            "options": {
              "const": [
                "azure_deep_noise_suppression"
              ]
            }
          }
        },
        "echoCancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "server_echo_cancellation"
            },
            "options": {
              "const": [
                "server_echo_cancellation"
              ]
            }
          }
        },
        "interruption": {
          "$ref": "#/definitions/interruption"
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "options"
          ],
          "properties": {
            "default": {
              "const": "en-US"
            },
            "options": {
              "const": [
                "en-US"
              ]
            }
          }
        },
        "customVoice": {
          "$ref": "#/definitions/customVoice"
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interruptResponse",
        "autoTruncate"
      ],
      "properties": {
        "interruptResponse": {
          "const": true
        },
        "autoTruncate": {
          "const": false
        }
      }
    },
    "customVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowEndpointIds",
        "allowLexicons",
        "allowPersonalVoice"
      ],
      "properties": {
        "enabled": {
          "const": false
        },
        "allowEndpointIds": {
          "const": false
        },
        "allowLexicons": {
          "const": false
        },
        "allowPersonalVoice": {
          "const": false
        }
      }
    },
    "photoAvatarAttributeValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,39}$"
      }
    },
    "photoAvatarCatalog": {
      "type": "object",
      "additionalProperties": false,
      "description": "Custom photo avatars (Create with AI). The creation surface is the Foundry portal's undocumented endpoint, so every provider-shaped value here is an observation pinned for review, not a public contract.",
      "required": [
        "displayName",
        "description",
        "homeRegion",
        "homeDataZone",
        "apiVersion",
        "requiredFeature",
        "projectSuffix",
        "baseModel",
        "billingModelId",
        "liveBillingModelId",
        "promptMaxChars",
        "attributes",
        "preview"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "homeRegion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,30}$"
        },
        "homeDataZone": {
          "enum": [
            "US",
            "EU"
          ]
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-preview)?$"
        },
        "requiredFeature": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,63}$"
        },
        "projectSuffix": {
          "const": "_PhotoAvatar"
        },
        "baseModel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,31}$"
        },
        "billingModelId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "liveBillingModelId": {
          "type": "string",
          "description": "The per-second price-book meter for live Voice Live sessions with this avatar product (real-time standard custom avatar).",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "promptMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gender",
            "age",
            "ethnicity",
            "style"
          ],
          "properties": {
            "gender": {
              "$ref": "#/definitions/photoAvatarAttributeValues"
            },
            "age": {
              "$ref": "#/definitions/photoAvatarAttributeValues"
            },
            "ethnicity": {
              "$ref": "#/definitions/photoAvatarAttributeValues"
            },
            "style": {
              "$ref": "#/definitions/photoAvatarAttributeValues"
            }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "maxBytes",
            "maxDimension",
            "contentTypes"
          ],
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net$"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            },
            "maxDimension": {
              "type": "integer",
              "minimum": 64,
              "maximum": 8192
            },
            "contentTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "application/octet-stream",
                  "image/png"
                ]
              }
            }
          }
        }
      }
    }
  }
}
