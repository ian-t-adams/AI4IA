    "adminSubjects": {
      "value": "${AI4IA_ADMIN_SUBJECTS=}"
    },
    "adminApiSecret": {
      "value": "${AI4IA_ADMIN_API_SECRET=}"
    },
    "webCustomDomain": {
      "value": "${AI4IA_WEB_CUSTOM_DOMAIN=}"
    },
    "webManagedCertName": {
      "value": "${AI4IA_WEB_MANAGED_CERT_NAME=}"
