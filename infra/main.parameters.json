{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workload": {
      "value": "ai4ia"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "owner": {
      "value": "${AI4IA_OWNER=ai4ia-operator}"
    },
    "costCenter": {
      "value": "${AI4IA_COST_CENTER=genai-demo}"
    },
    "postgresLocation": {
      "value": "${AI4IA_POSTGRES_LOCATION=centralus}"
    },
    "adminSubjects": {
      "value": "${AI4IA_ADMIN_SUBJECTS=}"
    },
    "adminApiSecret": {
      "value": "${AI4IA_ADMIN_API_SECRET=}"
    },
    "appEnvironment": {
      "value": "${AI4IA_APP_ENVIRONMENT=dev}"
    },
    "apiAuthProvider": {
      "value": "${AI4IA_AUTH_PROVIDER=dev}"
    },
    "entraTenantId": {
      "value": "${AI4IA_ENTRA_TENANT_ID=}"
    },
    "entraAudience": {
      "value": "${AI4IA_ENTRA_AUDIENCE=}"
    },
    "entraWebClientId": {
      "value": "${AI4IA_ENTRA_WEB_CLIENT_ID=}"
    },
    "entraApiScope": {
      "value": "${AI4IA_ENTRA_API_SCOPE=}"
    },
    "apimPublisherEmail": {
      "value": "${AI4IA_APIM_PUBLISHER_EMAIL=ai4ia@example.com}"
    },
    "budgetStartDate": {
      "value": "${AI4IA_BUDGET_START_DATE=}"
    },
    "enableOfficialMcp": {
      "value": true
    },
    "enableFoundryToolbox": {
      "value": true
    },
    "enablePrivateToolCatalog": {
      "value": true
    },
    "apiCenterLocation": {
      "value": "${AI4IA_API_CENTER_LOCATION=eastus}"
    },
    "webCustomDomain": {
      "value": "${AI4IA_WEB_CUSTOM_DOMAIN=}"
    },
    "webManagedCertName": {
      "value": "${AI4IA_WEB_MANAGED_CERT_NAME=}"
    },
    "proxyCustomDomain": {
      "value": "${AI4IA_PROXY_CUSTOM_DOMAIN=}"
    },
    "proxyManagedCertName": {
      "value": "${AI4IA_PROXY_MANAGED_CERT_NAME=}"
    },
    "proxyProfilesEnabled": {
      "value": "${AI4IA_PROXY_PROFILES_ENABLED=false}"
    },
    "proxyProfileProjectionJson": {
      "value": "${AI4IA_PROXY_PROFILE_PROJECTION_JSON=}"
    },
    "proxyPrioritiesEnabled": {
      "value": "${AI4IA_PROXY_PRIORITIES_ENABLED=false}"
    },
    "proxyPriorityWorkers": {
      "value": "${AI4IA_PROXY_PRIORITY_WORKERS=}"
    },
    "proxyEventHubTelemetryEnabled": {
      "value": "${AI4IA_PROXY_EVENTHUB_TELEMETRY_ENABLED=false}"
    },
    "proxyAsyncEnabled": {
      "value": "${AI4IA_PROXY_ASYNC_ENABLED=false}"
    },
    "proxyWorkers": {
      "value": "${AI4IA_PROXY_WORKERS=10}"
    },
    "proxyMinReplicas": {
      "value": "${AI4IA_PROXY_MIN_REPLICAS=1}"
    },
    "proxyMaxReplicas": {
      "value": "${AI4IA_PROXY_MAX_REPLICAS=3}"
    },
    "proxyAppConfigLabel": {
      "value": "${AI4IA_PROXY_APPCONFIG_LABEL=}"
    },
    "imageGenerationEnabled": {
      "value": true
    },
    "videoGenerationEnabled": {
      "value": true
    },
    "documentUnderstandingEnabled": {
      "value": true
    },
    "documentComputeEnabled": {
      "value": true
    },
    "inlineDocumentComputeEnabled": {
      "value": true
    },
    "searchEnabled": {
      "value": true
    },
    "searchLocation": {
      "value": "${AI4IA_SEARCH_LOCATION=eastus}"
    },
    "voiceLiveEnabled": {
      "value": true
    },
    "realtimeAllowedOrigins": {
      "value": "https://ai4ia.nomad-analytics.com"
    },
    "voiceLiveToolsEnabled": {
      "value": true
    },
    "speechVoiceLiveEnabled": {
      "value": "${AI4IA_SPEECH_VOICE_LIVE_ENABLED=false}"
    },
    "voiceProviderAllowlist": {
      "value": "${AI4IA_VOICE_PROVIDER_ALLOWLIST=azure_openai}"
    },
    "voiceDefaultProvider": {
      "value": "${AI4IA_VOICE_DEFAULT_PROVIDER=azure_openai}"
    },
    "speechVoiceLiveManagedIdentityAudience": {
      "value": "${AI4IA_SPEECH_VOICE_LIVE_MI_AUDIENCE=https://ai.azure.com}"
    },
    "autoSummarizationEnabled": {
      "value": true
    },
    "customToolsEnabled": {
      "value": true
    },
    "webSearchEnabled": {
      "value": true
    },
    "webIqApiKey": {
      "value": "${AI4IA_WEBIQ_API_KEY=}"
    }
  }
}
